# Turso DB (same credentials as flight-radar backend)
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-auth-token

# Secret key for URL-based auth (generate with: openssl rand -hex 32)
# Access: https://your-app.vercel.app/dashboard?key=YOUR_SECRET_KEY
DASHBOARD_SECRET_KEY=change-me-to-random-hex-string

# Optional: Override the origin airport (default: SIN)
ORIGIN_AIRPORT=SIN
